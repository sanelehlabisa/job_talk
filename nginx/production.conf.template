server_tokens off;
upstream jobtalk_backend {
    server unix:/run/jobtalk/api.sock;
}
# Browser-origin checks are an extra boundary, never proof of client identity.
# Non-browser clients can copy these headers; FastAPI still authenticates tokens.
map $http_origin $jobtalk_bad_origin {
    default 1;
    "" 0;
    "https://${APP_DOMAIN}" 0;
}
map $http_sec_fetch_site $jobtalk_foreign_site {
    default 0;
    cross-site 1;
    same-site 1;
}
map $request_method $jobtalk_bad_method {
    default 1;
    GET 0;
    HEAD 0;
    POST 0;
    PUT 0;
    DELETE 0;
    OPTIONS 0;
}
map $uri $jobtalk_auth_key {
    default "";
    ~^/api/auth/(guest|recruiter/request-code|recruiter/verify-code)/?$ $binary_remote_addr;
}
map $uri $jobtalk_cache_control {
    default "";
    ~^/api/ "no-store";
}
map $request_method $jobtalk_write_key {
    default "";
    POST $binary_remote_addr;
    PUT $binary_remote_addr;
    PATCH $binary_remote_addr;
    DELETE $binary_remote_addr;
}
limit_req_zone $binary_remote_addr zone=jobtalk_api:10m rate=5r/s;
limit_req_zone $jobtalk_write_key zone=jobtalk_writes:10m rate=30r/m;
limit_req_zone $jobtalk_auth_key zone=jobtalk_auth:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=jobtalk_connections:10m;
limit_req_status 429;
limit_conn_status 429;
client_header_timeout 10s;
client_body_timeout 10s;
send_timeout 30s;
reset_timedout_connection on;

# Do not log URL query strings, credentials, cookies or request bodies.
log_format jobtalk '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    listen 80;
    server_name ${APP_DOMAIN};
    keepalive_timeout 20s;
    access_log /var/log/nginx/access.log jobtalk;
    if ($host != "${APP_DOMAIN}") { return 444; }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 308 https://${APP_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};
    keepalive_timeout 20s;
    access_log /var/log/nginx/access.log jobtalk;
    if ($host != "${APP_DOMAIN}") { return 444; }

    ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    # Text-only chat and forms; the application has no uploads.
    client_max_body_size 128k;

    auth_basic "Job Talk private staging";
    auth_basic_user_file /etc/nginx/auth/.htpasswd;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    # Kept at server level so API responses inherit every security header.
    add_header Cache-Control $jobtalk_cache_control always;

    location = /proxy-health {
        auth_basic off;
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        # The API authenticates scoped Bearer tokens. Requiring HTTP Basic here
        # would reject every signed-in user because both use Authorization.
        auth_basic off;
        if ($jobtalk_bad_origin) { return 403; }
        if ($jobtalk_foreign_site) { return 403; }
        if ($jobtalk_bad_method) { return 405; }
        limit_req zone=jobtalk_api burst=15 nodelay;
        limit_req zone=jobtalk_writes burst=10 nodelay;
        limit_req zone=jobtalk_auth burst=5 nodelay;
        limit_conn jobtalk_connections 20;
        proxy_request_buffering on;
        proxy_hide_header Cache-Control;
        proxy_pass http://jobtalk_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location ~ (^|/)\. { return 404; }
    location ~* ^/(api/)?(docs|redoc|openapi\.json)(/|$) { return 404; }

    location / {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        proxy_pass http://frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
