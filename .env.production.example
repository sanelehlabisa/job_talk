# Settings grouped by component. Keep real secrets out of Git.

# --- Release ---
# Copy to an ignored production environment file on the VM and replace every placeholder.
JOB_TALK_IMAGE_TAG=replace-with-git-commit-sha

# --- Database ---
POSTGRES_DB=job_talk
POSTGRES_USER=job_talk
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://job_talk:replace-with-a-random-database-password@postgres:5432/job_talk

# --- Backend ---
APP_ENV=production
APP_DOMAIN=jobtalk.roventics.com
PUBLIC_ORIGIN=https://jobtalk.roventics.com
ALLOWED_HOSTS=jobtalk.roventics.com
CORS_ORIGINS=https://jobtalk.roventics.com
FORWARDED_ALLOW_IPS=*
DEMO_DATA_RETENTION_DAYS=30

# --- Authentication and access ---
AUTH_SESSION_HOURS=24
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-characters
# Optional operator account; uses the same approved email-code sign-in.
ADMIN_EMAIL=
RECRUITER_CODE_TTL_MINUTES=10
RECRUITER_CODE_MAX_ATTEMPTS=5
RECRUITER_CODE_REQUEST_COOLDOWN_SECONDS=60
RECRUITER_CODE_REQUEST_MAX_PER_HOUR=5

# --- Email and local inbox ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-a-strong-smtp-password
SMTP_USE_TLS=true
EMAIL_FROM=login@example.com

# --- LLM providers and request limits ---
# Choose gemini, openai or mock. Keys are backend-only; never prefix them VITE_.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=3000
AI_MAX_CALLS_PER_CHAT=12

# --- Frontend ---
SUPPORT_EMAIL=support@example.com

# --- Nginx and HTTPS ---
TLS_EMAIL=ops@example.com
STAGING_HTPASSWD_PATH=./secrets/nginx/.htpasswd
CERTIFICATE_RELOAD_SECONDS=3600
