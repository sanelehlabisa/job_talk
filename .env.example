# Docker Compose settings
POSTGRES_DB=job_talk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
FRONTEND_PORT=3000
BACKEND_PORT=8000
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini

# Only used when running the services outside Docker
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/job_talk
VITE_API_URL=http://localhost:8000/api
