# App host and administrator
APP_DOMAIN=localhost
ADMIN_EMAIL=

# Database
POSTGRES_DB=job_talk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Session security
SESSION_TOKEN_PEPPER=dev-only-session-token-pepper

# SMTP: false uses STARTTLS when available; true uses implicit TLS
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=login@example.com

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
