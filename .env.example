# One .env per installation. Keep real secrets out of Git.

# --- App ---
# Hostname only. On the VM: jobtalk.roventics.com
# Compose derives URLs and allowed origins; the browser always calls /api.
APP_DOMAIN=localhost
SUPPORT_EMAIL=support@example.com
ADMIN_EMAIL=

# --- Database ---
POSTGRES_DB=job_talk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# VM: replace the password with at least 16 random URL-safe characters.
# Compose builds DATABASE_URL from these values.

# --- Sessions ---
SESSION_TOKEN_PEPPER=dev-only-session-token-pepper
# VM: replace with at least 32 random characters.

# --- Email ---
# Local inbox: mailpit:1025. On the VM use your SMTP provider's settings.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=login@example.com
# false: STARTTLS when offered (typically 587); true: TLS from connection (465).
# Authenticated SMTP requires encryption. Mailpit needs no credentials.

# --- AI ---
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative: AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Local demo ---
DEMO_RECRUITER_EMAIL=recruiter@example.com
SEED_DEMO_JOBS=true
# Production Compose always disables demo seeding.

# --- HTTPS (production only) ---
TLS_EMAIL=
# Monitored email for certificates. Ports 80/443 are set in production Compose.
