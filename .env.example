# Settings grouped by component. Keep real secrets out of Git.
# One .env per installation, used by the explicitly selected dev/prod Compose.
# Defaults below run locally. On the VM replace development values as noted.

# --- Database ---
POSTGRES_DB=job_talk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Production: use a strong random URL-safe password (letters/digits); Compose
# builds DATABASE_URL from these three values, so there is no duplicate setting.

# --- Backend ---
# VM: APP_ENV=production, APP_DOMAIN=jobtalk.roventics.com,
# PUBLIC_ORIGIN/CORS_ORIGINS=https://jobtalk.roventics.com,
# ALLOWED_HOSTS=jobtalk.roventics.com. Keep localhost values on your dev machine.
APP_ENV=development
APP_DOMAIN=localhost
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
FORWARDED_ALLOW_IPS=127.0.0.1
BACKEND_PORT=8000
DEMO_DATA_RETENTION_DAYS=30

# --- Authentication and access ---
AUTH_SESSION_HOURS=24
SESSION_TOKEN_PEPPER=dev-only-session-token-pepper
# Production: replace with at least 32 random characters.
# Optional owner access. This email still needs recruiter approval and code login.
ADMIN_EMAIL=
RECRUITER_CODE_TTL_MINUTES=10
RECRUITER_CODE_MAX_ATTEMPTS=5
RECRUITER_CODE_REQUEST_COOLDOWN_SECONDS=60
RECRUITER_CODE_REQUEST_MAX_PER_HOUR=5

# --- Email and local inbox ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=login@example.com
MAILPIT_UI_PORT=8025
# Production: real SMTP host/port/credentials/sender, normally SMTP_USE_TLS=true.

# --- LLM providers and request limits ---
AI_PROVIDER=mock
# Set AI_PROVIDER=gemini for free-tier testing with fictional data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=3000
AI_MAX_CALLS_PER_CHAT=12

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000/api
SUPPORT_EMAIL=support@example.com

# --- Development demo data ---
DEMO_RECRUITER_EMAIL=recruiter@example.com
SEED_DEMO_JOBS=true
# Production Compose always disables seeding and ignores the demo recruiter.

# --- Production release and HTTPS (unused by development Compose) ---
# VM: set to the full deployed Git commit, and use a monitored TLS email address.
JOB_TALK_IMAGE_TAG=
TLS_EMAIL=
STAGING_HTPASSWD_PATH=./secrets/nginx/.htpasswd
CERTIFICATE_RELOAD_SECONDS=3600
